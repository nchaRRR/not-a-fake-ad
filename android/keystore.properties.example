# Copy to android/keystore.properties (do NOT commit) and fill in.
# Create a keystore once:
#   keytool -genkey -v -keystore kostebek-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias kostebek
storeFile=../kostebek-release.jks
storePassword=CHANGE_ME
keyAlias=kostebek
keyPassword=CHANGE_ME
